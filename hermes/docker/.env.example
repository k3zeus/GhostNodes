# ══════════════════════════════════════════════════════
#  GhostNodes — Hermes Module Environment
# ══════════════════════════════════════════════════════

# ── Open WebUI Core ──────────────────────────────────
# Generate: openssl rand -base64 48
HERMES_SECRET_KEY=CHANGE_ME
HERMES_SIGNUP=true

# ── API Providers ────────────────────────────────────
# Primary provider (OpenRouter — aggregates 200+ models)
OPENROUTER_API_KEY=sk-or-CHANGE_ME
OPENAI_API_BASE=https://openrouter.ai/api/v1

# Direct OpenAI (optional — add as second connection in UI)
# OPENAI_API_KEY=sk-CHANGE_ME

# Google AI (optional — add as second connection in UI)
# GOOGLE_AI_API_KEY=AIza-CHANGE_ME

# ── Telegram Bridge ─────────────────────────────────
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdef-CHANGE_ME

# API key from Open WebUI (Settings → Account → API Keys)
HERMES_API_KEY=CHANGE_ME

# Comma-separated Telegram user IDs allowed to use the bot
# Leave empty to allow all (NOT RECOMMENDED)
TELEGRAM_ALLOWED_USERS=

# Default model for Telegram conversations
TELEGRAM_DEFAULT_MODEL=openai/gpt-4o-mini
