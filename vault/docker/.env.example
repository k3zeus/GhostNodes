# ══════════════════════════════════════════════════════
#  GhostNodes — Vault Module Environment
# ══════════════════════════════════════════════════════

# ── Vaultwarden ──────────────────────────────────────
# Generate token: openssl rand -base64 48
VW_ADMIN_TOKEN=CHANGE_ME
VW_SIGNUPS=true
VW_DOMAIN=https://vault.ghostnode.local
VW_DATA_DIR=./vw-data

# ── Cloudflare Tunnel (configured in CF dashboard) ───
# Add route: vault.yourdomain.com → http://vaultwarden:80
# No env vars needed here — routing is in CF Zero Trust dashboard
