# Force LF line endings for all shell scripts and config files
# This prevents CRLF issues when cloned on Windows and deployed on Linux
*.sh text eol=lf
*.env text eol=lf
*.conf text eol=lf
nodenation text eol=lf
ghostnode text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf

# Preserve the imported Swissknife bundle byte-for-byte; it remains inactive.
services/osint/swissknife/*.sh -text
services/osint/swissknife/*.py -text
services/osint/swissknife/*.md -text
