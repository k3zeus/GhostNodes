# ══════════════════════════════════════════════════════
#  GhostNodes — Tailscale Module Environment
# ══════════════════════════════════════════════════════

# ── Auth Key ─────────────────────────────────────────
# Generate at: https://login.tailscale.com/admin/settings/keys
# Use a reusable, ephemeral key for automated setup
# Leave empty to authenticate interactively via URL
TS_AUTHKEY=

# ── Subnet Routes ────────────────────────────────────
# Subnets to advertise to the Tailscale network
# 10.21.21.0/24  = GhostNode AP network (wlan0)
# 172.17.0.0/16  = Docker internal network
# 192.168.1.0/24 = Home LAN (adjust to your network)
TS_ROUTES=10.21.21.0/24,172.17.0.0/16

# ── Extra Args ───────────────────────────────────────
# --accept-routes     : Accept routes from other Tailscale nodes
# --advertise-tags    : Tag for ACL policies
# --advertise-exit-node : Uncomment to use as exit node
TS_EXTRA_ARGS=--accept-routes --advertise-tags=tag:ghostnode
