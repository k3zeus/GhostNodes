ARG BASE=debian:bookworm
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive TERM=xterm LANG=C.UTF-8
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd systemd-sysv dbus sudo ca-certificates curl wget git \
    python3 python3-pytest python3-pexpect shellcheck procps iproute2 \
    iptables iptables-persistent iw hostapd dnsmasq unbound dnsutils \
    fail2ban python3-systemd openssh-server sqlite3 network-manager \
    ifupdown bridge-utils kmod locales && \
    useradd -m -s /bin/bash tester && \
    echo 'tester ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/tester && \
    mkdir -p /run/sshd && touch /etc/ghostnodes-tdd-image
WORKDIR /work
COPY tests/e2e/docker-daemon.json /etc/docker/daemon.json
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
